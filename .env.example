# ---- AI (server only, never exposed to the browser) ----
ANTHROPIC_API_KEY=
# Fast by default. Use claude-sonnet-5-5 for deeper answers.
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Firebase (client) : Firebase console > Project settings > Your apps > Web app ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Firebase Admin (server) : Project settings > Service accounts > Generate new private key ----
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n characters exactly as in the downloaded JSON
FIREBASE_PRIVATE_KEY=
